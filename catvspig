def draw_health_bar(x, y, w, h, current, maximum, name):
    ratio  = max(0.0, current / maximum)
    colour = GREEN if ratio > 0.5 else (YELLOW if ratio > 0.25 else RED)
    pygame.draw.rect(screen, DARK,   (x - 2, y - 2, w + 4, h + 4), border_radius=4)
    pygame.draw.rect(screen, GREY,   (x,     y,      w,     h),     border_radius=4)
    pygame.draw.rect(screen, colour, (x,     y,      int(w * ratio), h), border_radius=4)
    if name:
        txt = font_small.render(f"{name}  HP:{current:.1f}/{maximum}", True, WHITE)
        screen.blit(txt, (x, y - 18))

# ─── PLATFORM COLLISION HELPERS ───────────────────────────────────────────────
def get_platform_index(rect):
    inset = min(4, max(1, rect.w // 4))
    probe = pygame.Rect(rect.x + inset, rect.bottom, max(2, rect.w - inset * 2), 4)
    for i, p in enumerate(platforms):
        if i in (0, 1):          # skip left/right walls
            continue
        if probe.colliderect(p):
            return i
    return -1

def should_start_battle(cat_rect, pig_rect):
    ci = get_platform_index(cat_rect)
    pi = get_platform_index(pig_rect)
    if ci == -1 or pi == -1 or ci != pi:
        return False
    return cat_rect.right >= pig_rect.left and pig_rect.right >= cat_rect.left

def still_on_same_platform(cat_rect, pig_rect):
    ci = get_platform_index(cat_rect)
    pi = get_platform_index(pig_rect)
    return ci != -1 and ci == pi

# ─── COMBAT PRE-CALCULATION ───────────────────────────────────────────────────
def calculate_fight(cat_start_hp=None, pig_start_hp=None, cat_stats=None, pig_stats=None):
    cs = dict(cat_stats) if cat_stats is not None else dict(CAT_STATS)
    ps = dict(pig_stats) if pig_stats is not None else dict(PIG_STATS)

    cat_hp  = float(cat_start_hp) if cat_start_hp is not None else float(cs["health"])
    pig_hp  = float(pig_start_hp) if pig_start_hp is not None else float(ps["health"])
    cat_max = float(cs["health"])
    pig_max = float(ps["health"])
    events  = []

    cat_speed = cs["speed"]
    pig_speed = ps["speed"]
    cat_hit   = round(cat_speed / (cat_speed + pig_speed) * 100)
    pig_hit   = round(pig_speed / (cat_speed + pig_speed) * 100)

    cat_init = random.randint(1, 100) <= cat_hit
    pig_init = random.randint(1, 100) <= pig_hit

    if   cat_init and not pig_init: first = "cat"
    elif pig_init and not cat_init: first = "pig"
    else:                           first = "cat" if cat_speed >= pig_speed else "pig"

    order = ([("cat", cs, ps), ("pig", ps, cs)] if first == "cat"
             else [("pig", ps, cs), ("cat", cs, ps)])

    for _ in range(30):
        if cat_hp <= 0 or pig_hp <= 0:
            break
        for aname, atk, dfn in order:
            if cat_hp <= 0 or pig_hp <= 0:
                break
            dname      = "pig" if aname == "cat" else "cat"
            strikes    = round(atk["stamina"] / dfn["stamina"]) + 1
            hit_chance = round(atk["speed"] / (atk["speed"] + dfn["speed"]) * 100)
            damage     = atk["strength"] / dfn["defense"]
            for _ in range(strikes):
                if cat_hp <= 0 or pig_hp <= 0:
                    break
                hit = random.randint(1, 100) <= hit_chance
                if hit:
                    if dname == "pig": pig_hp = round(pig_hp - damage, 2)
                    else:              cat_hp  = round(cat_hp - damage, 2)
                events.append({"attacker": aname, "defender": dname, "hit": hit,
                               "damage": damage if hit else 0,
                               "cat_hp": cat_hp, "pig_hp": pig_hp})

    if   cat_hp <= 0 and pig_hp <= 0: winner = "draw"
    elif cat_hp <= 0:                  winner = "pig"
    elif pig_hp <= 0:                  winner = "cat"
    else:                              winner = "draw"

    return events, winner, cat_max, pig_max

# ─── GORE + EXPLOSION ─────────────────────────────────────────────────────────
class GorePiece:
    def __init__(self, image, x, y):
        self.image      = image
        self.rect       = image.get_rect(center=(x, y))
        self.vx         = random.uniform(-5.5, 5.5)
        self.vy         = random.uniform(-9, -3)
        self.rotation   = 0
        self.rot_speed  = random.uniform(-12, 12)
        self.spawn_time = time.time()
        self.lifetime   = GORE_LIFETIME

    def update(self, plats):
        if self.is_dead():
            return
        self.vy += 0.78
        self.rect.x += int(self.vx)
        self.rect.y += int(self.vy)
        self.vx      *= 0.975
        self.rotation = (self.rotation + self.rot_speed) % 360
        for p in plats:
            if self.rect.colliderect(p):
                if self.vx > 0 and self.rect.right > p.left:
                    self.rect.right = p.left; self.vx *= -0.65
                elif self.vx < 0 and self.rect.left < p.right:
                    self.rect.left = p.right; self.vx *= -0.65
                if self.vy > 0 and self.rect.bottom > p.top:
                    self.rect.bottom = p.top; self.vy *= -0.48; self.vx *= 0.82
                    if abs(self.vy) < 1.2: self.vy = 0
                elif self.vy < 0 and self.rect.top < p.bottom:
                    self.rect.top = p.bottom; self.vy *= -0.4

    def is_dead(self) -> bool:
        if time.time() - self.spawn_time > self.lifetime:
            return True
        return (self.rect.right < 0 or self.rect.left > WIDTH or
                self.rect.bottom < 0 or self.rect.top > HEIGHT)

    def draw(self, surface):
        if self.is_dead():
            return
        rotated  = pygame.transform.rotate(self.image, self.rotation)
        new_rect = rotated.get_rect(center=self.rect.center)
        if new_rect.colliderect(pygame.Rect(0, 0, WIDTH, HEIGHT)):
            surface.blit(rotated, new_rect)


class Explosion:
    def __init__(self, x: int, y: int):
        self.x          = x
        self.y          = y
        self.radius     = 5
        self.max_radius = 140
        self.alive      = True

    def update(self, objects: List[GorePiece]):
        self.radius += 9
        if self.radius > self.max_radius:
            self.alive = False
            return
        for obj in objects:
            dx   = obj.rect.centerx - self.x
            dy   = obj.rect.centery - self.y
            dist = math.hypot(dx, dy)
            if 0 < dist < self.radius:
                force   = (self.max_radius - dist) / self.max_radius
                obj.vx += (dx / dist) * force * 9.5
                obj.vy += (dy / dist) * force * 13.5

    def draw(self, surface):
        pass   # visual ellipse removed; physics still applied via update()


def _load_gore_imgs():
    sizes = [(7, 7), (12, 12), (7, 7), (10, 10)]   # 1/2 of original sizes
    imgs  = []
    for i, (w, h) in enumerate(sizes, start=1):
        path = os.path.join(sp, f"gore{i}.png")
        try:
            img = pygame.image.load(path).convert_alpha()
            imgs.append(to_grayscale(pygame.transform.scale(img, (w, h))))
        except Exception:
            surf = pygame.Surface((w, h), pygame.SRCALPHA)
            pygame.draw.rect(surf, (200, 30, 30, 200), surf.get_rect(), border_radius=3)
            imgs.append(to_grayscale(surf))
    return imgs

GORE_IMGS = _load_gore_imgs()

def spawn_gore(cx, cy, count=10) -> List[GorePiece]:
    return [GorePiece(random.choice(GORE_IMGS),
                      cx + random.randint(-25, 25),
                      cy + random.randint(-20, 20))
            for _ in range(count)]


# ─── NAVIGATOR ────────────────────────────────────────────────────────────────
class Navigator:
    def __init__(self, x, idle, walk, jump, face_right=True, is_cat=True):
        self.idle_spr     = idle
        self.walk_spr     = walk
        self.jump_spr     = jump
        h, w              = idle.get_height(), idle.get_width()
        self.rect         = pygame.Rect(x, -h, w, h)   # above screen; falls in under gravity
        self.vel_x        = 0.0
        self.vel_y        = 0.0
        self.on_ground    = False
        self.facing_right = face_right
        self.direction    = 1 if face_right else -1
        self.walk_timer   = random.randint(40, 180)
        self.anim_timer   = 0
        self.show_walk    = False
        self.cur_spr      = idle

        if is_cat:
            self.stats = dict(strength=random.randint(1, 3), defense=random.randint(1, 3),
                              speed=random.randint(3, 6),    stamina=random.randint(3, 6),
                              health=random.randint(3, 6))
        else:
            self.stats = dict(strength=random.randint(3, 6), defense=random.randint(3, 6),
                              speed=random.randint(1, 3),    stamina=random.randint(1, 3),
                              health=random.randint(3, 6))
        self.hp_max = float(self.stats["health"])
        self.hp     = float(self.stats["health"])

    def is_visible(self) -> bool:
        return self.rect.colliderect(pygame.Rect(0, 0, WIDTH, HEIGHT))

    def ai_tick(self):
        if not self.on_ground:
            return
        self.walk_timer -= 1
        if self.walk_timer <= 0 or random.random() < 0.08:
            self.direction  = random.choice([-1, 1])
            self.walk_timer = random.randint(80, 220)
        self.vel_x = self.direction * MOVE_SPEED

        lx     = self.rect.centerx + (110 if self.direction > 0 else -110)
        vision = pygame.Rect(lx - 45, self.rect.y - 220, 90, 260)
        for p in platforms:
            if vision.colliderect(p) and p.top < self.rect.bottom - 30:
                if random.random() < 0.2:
                    self.vel_y     = JUMP_POWER
                    self.on_ground = False
                break

    def physics(self):
        self.vel_y += GRAVITY
        self.rect.x += int(self.vel_x)
        for p in platforms:
            if self.rect.colliderect(p):
                if self.vel_x > 0:  self.rect.right = p.left
                else:               self.rect.left  = p.right
                if p.height > 100:  self.direction  = -self.direction
                self.vel_x = 0
                break

        self.rect.y += int(self.vel_y)
        self.on_ground = False
        for p in platforms:
            if self.rect.colliderect(p):
                if self.vel_y >= 0:
                    self.rect.bottom = p.top
                    self.vel_y       = 0
                    self.on_ground   = True
                else:
                    self.rect.top = p.bottom
                    self.vel_y    = 0

        if self.rect.left  < 0:     self.rect.left  = 0;     self.direction =  1; self.vel_x = 0
        if self.rect.right > WIDTH: self.rect.right = WIDTH; self.direction = -1; self.vel_x = 0

        if not self.on_ground:
            self.cur_spr    = self.jump_spr
            self.anim_timer = 0
        elif abs(self.vel_x) > 0.5:
            self.anim_timer += 1
            if self.anim_timer >= 1:
                self.show_walk  = not self.show_walk
                self.anim_timer = 0
            self.cur_spr = self.walk_spr if self.show_walk else self.idle_spr
        else:
            self.cur_spr    = self.idle_spr
            self.anim_timer = 0

        if   self.vel_x < 0: self.facing_right = False
        elif self.vel_x > 0: self.facing_right = True

    def draw_nav(self):
        img = self.cur_spr
        if not self.facing_right:
            img = pygame.transform.flip(img, True, False)
        screen.blit(img, self.rect.topleft)


# ─── BATTLE ───────────────────────────────────────────────────────────────────
class InWorldBattle:
    STEP_DELAY      = 300
    STANCE_FRAME_MS = 50
    PUNCH_FRAME_MS  = 66

    def __init__(self, cat: Navigator, pig: Navigator):
        self.cat = cat
        self.pig = pig
        cat.vel_x = 0.0
        pig.vel_x = 0.0

        events, winner, _, _ = calculate_fight(
            cat_start_hp=cat.hp, pig_start_hp=pig.hp,
            cat_stats=cat.stats, pig_stats=pig.stats)
        self.events    = events
        self.winner    = winner
        self.cat_max   = cat.hp_max
        self.pig_max   = pig.hp_max
        self.cat_hp    = cat.hp
        self.pig_hp    = pig.hp

        self.event_idx    = -1
        self.timer        = 0
        self.state        = "fighting"

        self.cat_override = None
        self.pig_override = None
        self.cat_shake    = 0
        self.pig_shake    = 0

        self.atk_who   = None
        self.atk_phase = 0
        self.anim_t    = 0
        self.pend_hit  = False
        self.pend_def  = None

        self._face_each_other()

    def _face_each_other(self):
        if self.cat.rect.centerx <= self.pig.rect.centerx:
            self.cat.facing_right = True;  self.pig.facing_right = False
        else:
            self.cat.facing_right = False; self.pig.facing_right = True

    def update(self, dt):
        for nav in (self.cat, self.pig):
            nav.vel_y += GRAVITY
            nav.rect.y += int(nav.vel_y)
            nav.on_ground = False
            for p in platforms:
                if nav.rect.colliderect(p):
                    if nav.vel_y >= 0:
                        nav.rect.bottom = p.top; nav.vel_y = 0; nav.on_ground = True
                    else:
                        nav.rect.top = p.bottom; nav.vel_y = 0
            nav.vel_x = 0.0

        if not still_on_same_platform(self.cat.rect, self.pig.rect):
            self.state = "cancelled"
            return

        self._face_each_other()

        if self.cat_shake:
            self.cat_shake = int(self.cat_shake * 0.65)
            if abs(self.cat_shake) < 1: self.cat_shake = 0
        if self.pig_shake:
            self.pig_shake = int(self.pig_shake * 0.65)
            if abs(self.pig_shake) < 1: self.pig_shake = 0

        if self.atk_who is not None:
            self.anim_t -= dt
            if self.anim_t <= 0:
                if self.atk_phase == 0:
                    self.atk_phase = 1
                    self.anim_t    = self.PUNCH_FRAME_MS
                    if self.atk_who == "cat": self.cat_override = cat_b_punch
                    else:                     self.pig_override = pig_b_punch
                    if self.pend_hit:
                        if self.pend_def == "pig":
                            self.pig_override = pig_b_flinch; self.pig_shake = 18
                        else:
                            self.cat_override = cat_b_flinch; self.cat_shake = -18
                else:
                    self.cat_override = None
                    self.pig_override = None
                    self.atk_who      = None
                    self.atk_phase    = 0
                    self.pend_hit     = False

        self.timer += dt
        if self.timer >= self.STEP_DELAY:
            self.timer = 0
            self._next_event()

    def _next_event(self):
        self.event_idx += 1
        if self.event_idx >= len(self.events):
            self.state = "done"
            return
        ev             = self.events[self.event_idx]
        self.cat_hp    = ev["cat_hp"]
        self.pig_hp    = ev["pig_hp"]
        self.atk_who   = ev["attacker"]
        self.atk_phase = 0
        self.anim_t    = self.STANCE_FRAME_MS
        if self.atk_who == "cat":
            self.cat_override = cat_b_stance; self.pig_override = None
        else:
            self.cat_override = None;         self.pig_override = pig_b_stance
        self.pend_hit = ev["hit"]
        self.pend_def = ev["defender"]

    def draw(self):
        if not (self.cat.is_visible() or self.pig.is_visible()):
            return

        pig_faces_left = self.pig.rect.centerx >= self.cat.rect.centerx
        flip_map = {pig_b_idle:   pig_b_idle_f,   pig_b_stance: pig_b_stance_f,
                    pig_b_punch:  pig_b_punch_f,   pig_b_flinch: pig_b_flinch_f}

        raw_cat = self.cat_override if self.cat_override else cat_b_idle
        cat_img = raw_cat if self.cat.facing_right else pygame.transform.flip(raw_cat, True, False)
        screen.blit(cat_img, (self.cat.rect.x + self.cat_shake, self.cat.rect.y))

        raw_pig   = self.pig_override if self.pig_override else pig_b_idle
        pig_faced = flip_map.get(raw_pig, pig_b_idle_f)
        if not pig_faces_left:
            pig_faced = pygame.transform.flip(pig_faced, True, False)
        screen.blit(pig_faced, (self.pig.rect.x + self.pig_shake, self.pig.rect.y))


# ─── SPAWN HELPERS ────────────────────────────────────────────────────────────
def make_cat(x):
    return Navigator(x, cat_nav_idle, cat_nav_walk, cat_nav_jump, face_right=True,  is_cat=True)

def make_pig(x):
    return Navigator(x, pig_nav_idle, pig_nav_walk, pig_nav_jump, face_right=False, is_cat=False)


# ─── MAIN ─────────────────────────────────────────────────────────────────────
def main():
    global bg_surface, platforms
    bg_surface, platforms = generate_city()

    cats        : list[Navigator]     = []
    pigs        : list[Navigator]     = []
    battles     : list[InWorldBattle] = []
    gore_pieces : List[GorePiece]     = []
    explosions  : List[Explosion]     = []
    spawn_timer = 0

    while True:
        dt = clock.tick(FPS)

        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                pygame.quit(); sys.exit()
            if ev.type == pygame.KEYDOWN and ev.key == pygame.K_ESCAPE:
                pygame.quit(); sys.exit()

        # ── AUTO-SPAWN every SPAWN_INTERVAL ms ───────────────────────────────
        spawn_timer += dt
        if spawn_timer >= SPAWN_INTERVAL:
            spawn_timer = 0
            rx  = lambda: random.randint(40, WIDTH - 40)
            nc, np_ = len(cats), len(pigs)
            if nc == np_:
                cats.append(make_cat(rx()))
                pigs.append(make_pig(rx()))
            elif nc > np_:
                # losing side (pigs) gets one extra spawn
                cats.append(make_cat(rx()))
                pigs.append(make_pig(rx()))
                pigs.append(make_pig(rx()))
            else:
                # losing side (cats) gets one extra spawn
                cats.append(make_cat(rx()))
                cats.append(make_cat(rx()))
                pigs.append(make_pig(rx()))

        draw_bg()

        def fighting_ids():
            ids = set()
            for b in battles:
                if b.state == "fighting":
                    ids.add(id(b.cat))
                    ids.add(id(b.pig))
            return ids

        finished = []
        for b in battles:
            b.update(dt)
            if b.state == "cancelled":
                finished.append(b)
                continue

            b.draw()

            if b.state == "done":
                if b.winner in ("pig", "draw"):
                    if b.cat in cats: cats.remove(b.cat)
                    cx, cy = b.cat.rect.centerx, b.cat.rect.centery
                    gore_pieces.extend(spawn_gore(cx, cy, count=12))
                    explosions.append(Explosion(cx, cy))

                if b.winner in ("cat", "draw"):
                    if b.pig in pigs: pigs.remove(b.pig)
                    cx, cy = b.pig.rect.centerx, b.pig.rect.centery
                    gore_pieces.extend(spawn_gore(cx, cy, count=12))
                    explosions.append(Explosion(cx, cy))

                if b.winner != "pig":
                    b.cat.hp = b.cat_hp
                    b.cat.walk_timer = random.randint(40, 180)
                if b.winner != "cat":
                    b.pig.hp = b.pig_hp
                    b.pig.walk_timer = random.randint(40, 180)

                finished.append(b)

        for b in finished:
            battles.remove(b)

        busy = fighting_ids()
        for nav in cats + pigs:
            if id(nav) in busy:
                continue
            nav.ai_tick()
            nav.physics()
            if nav.is_visible():
                nav.draw_nav()

        busy = fighting_ids()
        for c in cats:
            if id(c) in busy:
                continue
            for p in pigs:
                if id(p) in busy:
                    continue
                if should_start_battle(c.rect, p.rect):
                    battles.append(InWorldBattle(c, p))
                    busy.add(id(c))
                    busy.add(id(p))
                    break

        for g in gore_pieces: g.update(platforms)
        for e in explosions:  e.update(gore_pieces)
        gore_pieces = [g for g in gore_pieces if not g.is_dead()]
        explosions  = [e for e in explosions  if e.alive]

        for g in gore_pieces: g.draw(screen)
        for e in explosions:  e.draw(screen)

        pygame.display.flip()

if __name__ == "__main__":
    main()
