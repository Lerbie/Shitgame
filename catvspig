# ─── CITY GENERATION ──────────────────────────────────────────────────────────
def draw_building(surface, x, base_y, width, height):
    color = random.choice(BUILDING_COLORS)
    pygame.draw.rect(surface, color, pygame.Rect(x, base_y - height, width, height))

    window_size = random.randint(max(2, int(3 * w_scale)), max(2, int(5 * w_scale)))
    spacing     = window_size + random.randint(max(1, int(2 * w_scale)), max(2, int(4 * w_scale)))
    for wx in range(x + max(3, int(5 * w_scale)), x + width - window_size, spacing):
        for wy in range(base_y - height + max(3, int(5 * w_scale)),
                        base_y - max(3, int(5 * w_scale)), spacing):
            if random.random() > 0.20:
                pygame.draw.rect(surface, random.choice(WINDOW_COLORS),
                                 (wx, wy, window_size, window_size))

    top_y = base_y - height
    if random.random() < 0.28:
        roof_h      = random.randint(int(20 * h_scale), int(55 * h_scale))
        peak_offset = random.randint(int(10 * w_scale),
                                     max(int(10 * w_scale), width - int(10 * w_scale)))
        pygame.draw.polygon(surface, color,
                            [(x, top_y), (x + width, top_y),
                             (x + peak_offset, top_y - roof_h)])
    else:
        if random.random() < 0.32:
            spire_bw = int(width * random.uniform(0.55, 0.85))
            spire_x  = x + (width - spire_bw) // 2
            t1h = random.randint(int(22 * h_scale), int(48 * h_scale))
            pygame.draw.rect(surface, color, (spire_x, top_y - t1h, spire_bw, t1h))
            t2w = int(spire_bw * random.uniform(0.60, 0.82))
            t2x = x + (width - t2w) // 2
            t2h = random.randint(int(18 * h_scale), int(40 * h_scale))
            pygame.draw.rect(surface, color, (t2x, top_y - t1h - t2h, t2w, t2h))
            sw  = random.randint(max(2, int(3 * w_scale)), max(3, int(7 * w_scale)))
            sx  = x + (width - sw) // 2
            sh  = random.randint(int(65 * h_scale), int(195 * h_scale))
            pygame.draw.rect(surface, color,
                             (sx, top_y - t1h - t2h - sh, sw, sh))

    return pygame.Rect(x, base_y - height, width, 40)   # roof platform (thick to prevent tunneling)


def draw_layer(surface, y_base, min_h, max_h):
    roofs = []
    x = 0
    while x < WIDTH:
        w = random.randint(int(42 * w_scale), int(135 * w_scale))
        h = random.randint(min_h, max_h)
        roofs.append(draw_building(surface, x, y_base, w, h))
        x += w - random.randint(int(9 * w_scale), int(34 * w_scale))
    return roofs


def generate_city():
    surface = pygame.Surface((WIDTH, HEIGHT))
    surface.fill(SKY_COLOR)
    # Five layers, each ~140px shorter than the previous, drawn back-to-front.
    # Roof heights stay within one jump of each other so NPCs can navigate up/down.
    roofs_l1 = draw_layer(surface, HEIGHT, int(700 * h_scale), int(820 * h_scale))
    roofs_l2 = draw_layer(surface, HEIGHT, int(560 * h_scale), int(680 * h_scale))
    roofs_l3 = draw_layer(surface, HEIGHT, int(420 * h_scale), int(540 * h_scale))
    roofs_l4 = draw_layer(surface, HEIGHT, int(280 * h_scale), int(400 * h_scale))
    roofs_l5 = draw_layer(surface, HEIGHT, int(140 * h_scale), int(260 * h_scale))

    # Greyscale gradient overlay: transparent at top, dark at bottom
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    for y in range(HEIGHT):
        alpha = int((y / HEIGHT) * 180)
        pygame.draw.line(overlay, (15, 15, 20, alpha), (0, y), (WIDTH, y))
    surface.blit(overlay, (0, 0))

    plats = [
        pygame.Rect(-20,    0, 20,     HEIGHT),         # 0: left wall
        pygame.Rect(WIDTH,  0, 20,     HEIGHT),         # 1: right wall
        pygame.Rect(0, HEIGHT - 40, WIDTH, 40),         # 2: floor safety net
        *roofs_l1, *roofs_l2, *roofs_l3, *roofs_l4, *roofs_l5,
    ]
    return surface, plats

