# ─── GRAYSCALE HELPER ─────────────────────────────────────────────────────────
def to_grayscale(surf):
    gs = pygame.Surface(surf.get_size(), pygame.SRCALPHA)
    for px in range(surf.get_width()):
        for py in range(surf.get_height()):
            col  = surf.get_at((px, py))
            gray = int(col.r * 0.299 + col.g * 0.587 + col.b * 0.114)
            gs.set_at((px, py), (gray, gray, gray, col.a))
    return gs

